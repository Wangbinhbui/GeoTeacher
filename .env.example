POSTGRES_DB=geoteacher
POSTGRES_USER=geoteacher
POSTGRES_PASSWORD=replace-with-a-local-password
GEOTEACHER_BOOTSTRAP_ADMIN_USERNAME=teacher
GEOTEACHER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
GEOTEACHER_BOOTSTRAP_ADMIN_DISPLAY_NAME=Giáo viên Địa lý
# Chỉ dùng khi chạy backend trực tiếp; Docker Compose dùng volume geoteacher_files.
FILE_STORAGE_ROOT=./data/files

# Bật sau khi đã đọc cảnh báo quyền riêng tư trên màn hình tạo đề AI.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com
